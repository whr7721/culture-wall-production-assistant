{
  "name": "culture-wall-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "invite:add": "tsx scripts/create-invite.ts",
    "invite:limit": "tsx scripts/set-invite-limit.ts",
    "test:browser": "tsx scripts/acceptance-browser.ts",
    "test:project-browser": "tsx scripts/acceptance-project.ts",
    "test:vector-browser": "tsx scripts/acceptance-color-layers.ts",
    "test:ocr-browser": "tsx scripts/acceptance-ocr.ts"
  },
  "dependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "rapidocr-node": "0.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.5",
    "svgpath": "2.6.0",
    "tsx": "^4.20.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "ag-psd": "^31.0.2",
    "concurrently": "^9.2.1",
    "fabric": "^7.4.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
