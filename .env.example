# 复制为 .env 后填写。真实密钥不会提交 Git。
# relay 为现有已验证通道；alibaba 为阿里云百炼官方通道，不会自动故障切换。
IMAGE_PROVIDER=relay
IMAGE_API_BASE_URL=https://api.itoo.me
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5
# 按百炼工作空间和 API Key 所在地域填写，例如 https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_IMAGE_BASE_URL=
ALIBABA_IMAGE_API_KEY=
ALIBABA_IMAGE_MODEL=qwen-image-3.0
ALIBABA_IMAGE_DOWNLOAD_HOSTS=dashscope-result-sz.oss-cn-shenzhen.aliyuncs.com
# 可选：卡米 New API 的 Gemini 原生图像接口。只在服务端填写新密钥。
# 若卡米后台的模型 ID 或接口协议不同，先核实并调整；不要直接使用聊天中暴露的密钥。
KAMI_IMAGE_BASE_URL=https://www.kamiapi.top
KAMI_IMAGE_API_KEY=
KAMI_BANANA_MODEL=gemini-3.1-flash-image-preview
KAMI_BANANA_4K_MODEL=gemini-3-pro-image-preview
IMAGE_REQUEST_TIMEOUT_MS=300000
PORT=8787

# Kimi 官方需求整理：与生图独立计费，默认关闭。批准费用后再启用。
KIMI_ENABLED=0
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_TIMEOUT_MS=90000
PLANNER_DAILY_LIMIT=5
PLANNER_TOTAL_LIMIT=20
PLANNER_USAGE_FILE=data/planner-usage.json

# 受邀测试部署：开启后，所有页面、API 和图片均需要受邀账号。
REQUIRE_INVITES=0
INVITES_FILE=data/invites.json
USAGE_FILE=data/usage.json
GENERATED_DIR=generated
PROJECTS_DIR=data/projects
DAILY_GENERATION_LIMIT=5
TOTAL_GENERATION_LIMIT=20
MAX_CONCURRENT_GENERATIONS=1
MIN_GENERATION_INTERVAL_MS=60000
# 若中转站返回图片 URL，只有中转站主机或下列额外 HTTPS 主机可下载。
IMAGE_DOWNLOAD_HOSTS=
