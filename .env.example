# 复制为 .env 后填写。真实密钥不会提交 Git。
IMAGE_API_BASE_URL=https://api.itoo.me
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5
IMAGE_REQUEST_TIMEOUT_MS=300000
PORT=8787

# 受邀测试部署：开启后，所有页面、API 和图片均需要受邀账号。
REQUIRE_INVITES=0
INVITES_FILE=data/invites.json
USAGE_FILE=data/usage.json
GENERATED_DIR=generated
DAILY_GENERATION_LIMIT=5
TOTAL_GENERATION_LIMIT=20
MAX_CONCURRENT_GENERATIONS=1
MIN_GENERATION_INTERVAL_MS=60000
# 若中转站返回图片 URL，只有中转站主机或下列额外 HTTPS 主机可下载。
IMAGE_DOWNLOAD_HOSTS=
